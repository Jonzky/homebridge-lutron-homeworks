{
  "private": false,
  "displayName": "Homeworks",
  "name": "homebridge-homeworks-alt",
  "version": "1.2.0",
  "description": "Homeworks Plugin for HomeBridge, tweaks to work with my homeworks processor. Full credit to kikolobo for the original",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jonzky/homebridge-lutron-homeworks.git"
  },
  "bugs": {
    "url": "https://github.com/Jonzky/homebridge-lutron-homeworks/issues"
  },
  "homepage": "https://github.com/Jonzky/homebridge-lutron-homeworks#readme",
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "lutron",
    "homeworks"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
